{
  "expo": {
    "name": "TicketMatchPro",
    "slug": "ticketmatchpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ticketmatchpro",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C3BFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ticketmatchpro.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C3BFF"
      },
      "package": "com.ticketmatchpro.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload ticket images."
        }
      ],
      "expo-asset",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "54096ee7-df7b-4b51-bdf3-176e52e2144a"
      }
    },
    "owner": "nikhilreddy1407"
  }
}
