# TicketMatchPro Environment Configuration
# Copy this file to .env and fill in your credentials

# Supabase Credentials
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay Integration (Optional - Demo mode is used if empty)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
